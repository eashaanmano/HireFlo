# Copy to backend/.env and adjust. Every value has a safe local default.

# SQLite for local runs; docker-compose sets a PostgreSQL URL instead.
DATABASE_URL=sqlite:///./data/driveops.db
# Neon (serverless PostgreSQL): paste the connection string from Neon > Connect, as is. Use the pooled
# ("-pooler") host for the app. See docs/NEON_AZURE_GROQ.md.
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# REQUIRED in production: a long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-string

# Demo mode shows OTP codes on the login screen instead of only emailing them.
DEMO_MODE=true

# Public URL used to build recruiter and panel magic links.
PUBLIC_URL=http://localhost:5173

# Set true when served over HTTPS.
COOKIE_SECURE=false

# Allowed browser origins (comma separated). Only needed when the frontend runs on another origin.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- AI (all optional; see docs/NEON_AZURE_GROQ.md)
# Without any of these, JD extraction uses the built-in pattern extractor and the assistant answers from the
# policy engine. Configure one or both; each task tries the best provider first and falls back to the other.
#
# Azure OpenAI (Microsoft Foundry), called through the official `openai` SDK on Azure's v1 API.
# ENDPOINT: portal -> your resource -> Keys and Endpoint (with or without /openai/v1/ at the end).
# DEPLOYMENT: the *deployment name* you typed when deploying the model, e.g. gpt-4.1-mini.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
#
# Groq (free tier, very fast): key from console.groq.com > API Keys.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
#
# Who does what: auto = Groq for chat (speed), Azure for JD extraction and rewrites (quality).
# LLM_CHAT_PROVIDER=auto          # auto | azure | groq | generic
# LLM_EXTRACT_PROVIDER=auto       # auto | azure | groq | generic
# ASSISTANT_ENABLED=true
#
# Older generic setting, still supported: anthropic, or any OpenAI-compatible API.
# LLM_PROVIDER=anthropic          # none | anthropic | openai
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=

# ---------------------------------------------------------------- LangSmith tracing (optional)
# Traces every AI workflow: assistant chat, JD extraction, policy answers and the provider test, with each LLM call,
# its tokens, latency and errors. Key: smith.langchain.com -> Settings -> API Keys. See docs/NEON_AZURE_GROQ.md.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # eu.api.smith.langchain.com for the EU region
# Agent-based workspace: the agent's identifier and the environment to log to.
# LANGSMITH_AGENT_ID=hireflo
# LANGSMITH_AGENT_ENVIRONMENT=local
# Project-based or self-hosted workspace instead (leave the two agent lines out):
# LANGSMITH_PROJECT=hireflo

# Optional e-mail delivery for OTPs and notifications.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=HireFlo <no-reply@example.com>
# Send real e-mail only to these inboxes (comma separated); other addresses get their OTP in the server log.
# The demo's addresses are fictional but look like real @nitc.ac.in ones, so list only your own here.
# EMAIL_ONLY_TO=you@nitc.ac.in

# Optional Telegram digests.
# TELEGRAM_BOT_TOKEN=

# Deadline reminders to eligible students who have not applied (hours before the deadline; 0 turns it off).
# NUDGE_HOURS_BEFORE=24
# Local time used on printed drive-day sheets, in minutes from UTC (IST = 330).
# DISPLAY_UTC_OFFSET_MIN=330
# Interview working hours (local time). A round that doesn't fit in a day continues the next working day.
# The Schedule tab can override these for each round.
# WORK_DAY_START=09:00
# WORK_DAY_END=18:00
# WORK_BREAKS=13:00-14:00
# SCHEDULE_MAX_DAYS=3
# SCHEDULE_SKIP_SUNDAYS=true
